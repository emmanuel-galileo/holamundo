prefix=/usr/local/mxe/usr/x86_64-w64-mingw32.shared
libdir=/usr/local/mxe/usr/x86_64-w64-mingw32.shared/lib
includedir=/usr/local/mxe/usr/x86_64-w64-mingw32.shared/include

Name: poppler
Description: PDF rendering library
Version: 26.08.0
Requires.private: freetype2 >= 2.13 zlib libjpeg libopenjp2 lcms2 >= 2.14 libpng libtiff-4 >= 4.5

Libs: -L${libdir} -lpoppler
Libs.private: -lgdi32
Cflags: -I${includedir}/poppler
