prefix=/usr/local/mxe/usr/x86_64-w64-mingw32.shared
includedir=${prefix}/include
libdir=${prefix}/lib

Name: harfbuzz-cairo
Description: HarfBuzz cairo support
Version: 14.3.1
Requires: harfbuzz =  14.3.1
Requires.private: freetype2 >=  20.0.14, glib-2.0 >=  2.30.0, cairo >=  1.10.0
Libs: -L${libdir} -lharfbuzz-cairo
Libs.private: -lm -L${libdir} -lharfbuzz
Cflags: -I${includedir}/harfbuzz
