prefix=/usr/local/mxe/usr/x86_64-w64-mingw32.shared
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libtiff
Description:  Tag Image File Format (TIFF) library.
Version: 4.7.2
Libs: -L${libdir} -ltiff
Libs.private: 
Cflags: -I${includedir}
Requires.private:  zlib libjpeg libzstd libwebp
