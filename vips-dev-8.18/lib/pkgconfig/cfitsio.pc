prefix=/usr/local/mxe/usr/x86_64-w64-mingw32.shared
exec_prefix=${prefix}
libdir="/usr/local/mxe/usr/x86_64-w64-mingw32.shared/lib"
includedir="/usr/local/mxe/usr/x86_64-w64-mingw32.shared/include"

Name: cfitsio
Description: FITS File Subroutine Library
URL: https://heasarc.gsfc.nasa.gov/fitsio/
Version: 4.7.0
Libs: -L${libdir} -lcfitsio
Libs.private:  -lz -lm
Cflags: -I${includedir}
